# Rust build cache
target/

# .NET build artifacts.
#
# `bin/` matches a directory of that name at any depth, which silently swallowed
# a Rust source folder — `kiza-setup/src-tauri/src/bin/` — for a whole release.
# The build worked on the machine that had the file and failed in CI thirteen
# minutes in, with cargo reporting a bin target that simply was not there.
bin/
obj/
!**/src/bin/

# Node
node_modules/

# Build outputs
build/
dist/
dist_dev/
dist_prod/
dist_full/
coverage/

# Package manager and framework caches
.cache/
.npm/
.pnpm-store/
.turbo/
.vite/

# Updater signing keys - never commit private keys
.tauri-keys/
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.sig

# Local environments and secrets
.env
.env.*
!.env.example
secrets.*
*.secret

# Local archives and logs
_archive/
*.log
build_log.txt
detailed_build_log*.txt

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/

# Local agent and Codex state
.agents/
.codex/
skills-lock.json

# Built installers
releases/

# Tool outputs
.playwright-cli/
graphify-out/
test-results/
KizaaModEngine-Tauri/output/
KizaaModEngine-Tauri/scripts/*-preview.mjs
KizaaModEngine-Tauri/scripts/*.png

# Separate project with its own git repo and local secrets
KizaThemeStudio/

# The Obsidian vault. It is the project's design record, but it is kept on the
# author's machine rather than published: it holds open questions, mistakes
# already made, and a 3398-note code graph regenerated from the source.
Kiza Launcher/

# The update service's secrets while it runs on this machine.
KizaaModEngine-Tauri/cloudflare/.dev.vars

# The bot's Discord token and the key to every test channel.
kiza-bot/.env
