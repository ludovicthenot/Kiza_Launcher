# Kiza's test-access bot.
#
# Copy this file to `.env` beside index.js and fill it in. The bot reads it at
# startup; a real environment variable, where your panel can set one, wins over
# what is written here.
#
# Never commit the filled-in file. It holds the Discord token and the key to
# every test channel.

# From the Discord application: Bot tab.
DISCORD_TOKEN=

# From the Discord application: General Information (the same number the bot
# token starts with, decoded).
DISCORD_APPLICATION_ID=1211291216751370310

# Your server. Right-click it in Discord with Developer Mode on, Copy Server ID.
DISCORD_GUILD_ID=

# Kiza's update service, and the secret it shares with this bot. The token must
# be the same value as the Worker's BOT_TOKEN secret.
KIZA_SERVICE=https://kiza-updates.nefer-blcdureste.workers.dev
KIZA_BOT_TOKEN=

# Optional. Role ids that grant a channel on their own, comma separated: a
# patron role, the booster role, a testers role. Somebody who gains one is
# added; somebody who loses it is removed. Leave empty to do everything by
# hand with /alpha add.
ROLE_ALPHA=
ROLE_BETA=
