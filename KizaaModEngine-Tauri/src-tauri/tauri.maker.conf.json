{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiza Maker",
  "identifier": "com.kizamods.maker",
  "app": {
    "windows": [
      {
        "title": "Kiza Maker",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://kiza-updates.nefer-blcdureste.workers.dev/v1/latest/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
