{
  "name": "kizaamodengine-tauri",
  "private": true,
  "version": "0.0.310",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "build:base-mod": "node kiza-base-mod/build.mjs",
    "test:base-mod": "node kiza-base-mod/build.mjs --test",
    "test:e2e": "playwright test",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "quality": "npm run test:base-mod && npm run lint && npm run test && npm run build",
    "release:check": "npm run quality && npm run test:e2e && node scripts/verify-release-config.js && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path kiza-setup/src-tauri/Cargo.toml --check && cargo clippy --manifest-path kiza-setup/src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path kiza-setup/src-tauri/Cargo.toml && node scripts/build-installer.mjs",
    "bump-version": "node scripts/bump-version.js",
    "build:app": "npm run bump-version && tauri build",
    "test:setup": "cargo test --manifest-path kiza-setup/src-tauri/Cargo.toml",
    "build:installer": "node scripts/build-installer.mjs",
    "cloudflare:deploy": "node scripts/cloudflare-setup.mjs",
    "cloudflare:secret": "npx wrangler secret put SUPPORT_WEBHOOK --config cloudflare/wrangler.jsonc",
    "cloudflare:tail": "npx wrangler tail --config cloudflare/wrangler.jsonc",
    "release:publish": "node scripts/publish-release.mjs",
    "cloudflare:verify": "node cloudflare/verify.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.19",
    "@tanstack/react-query": "^5.90.21",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.27",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.6",
    "wrangler": "^4.125.0"
  }
}
