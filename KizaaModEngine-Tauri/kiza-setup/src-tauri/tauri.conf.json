{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiza Setup",
  "version": "0.0.309",
  "identifier": "com.kizamods.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "setup",
        "title": "Kiza Setup",
        "width": 620,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
